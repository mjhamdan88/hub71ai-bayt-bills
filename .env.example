DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
# Allow local access and Portacode's per-device exposed hostnames.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.exposify.net
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_PUBLIC_ORIGIN=http://localhost:8000
POSTGRES_PASSWORD=replace-with-a-strong-password
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
PORTACODE_RESPONSES_BASE_URL=http://127.0.0.1:61789/v1
PORTACODE_RESPONSES_API_KEY=portacode-local
PORTACODE_LLM_MODEL=gpt-5.6-terra
